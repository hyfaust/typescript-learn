{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "lib": ["deno.ns", "deno.window"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "options": {
      "useTabs": false,
      "indentWidth": 2,
      "lineWidth": 100,
      "singleQuote": false,
      "proseWrap": "preserve"
    }
  },
  "tasks": {
    "dev": "deno run --watch --allow-read custom-errors.ts",
    "run:custom-errors": "deno run --allow-read custom-errors.ts",
    "run:error-handling": "deno run --allow-read error-handling.ts",
    "run:all": "deno run --allow-read custom-errors.ts error-handling.ts",
    "check": "deno check *.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test --allow-read",
    "test:coverage": "deno test --coverage=coverage --allow-read",
    "coverage": "deno coverage --html=coverage",
    "coverage:lcov": "deno coverage --lcov=coverage.lcov"
  },
  "imports": {
    "std/": "https://deno.land/std@0.208.0/",
    "https://": "https://deno.land/x/"
  }
}