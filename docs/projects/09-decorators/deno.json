{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "lib": ["deno.ns", "deno.window"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "options": {
      "useTabs": false,
      "indentWidth": 2,
      "lineWidth": 100,
      "singleQuote": false,
      "proseWrap": "preserve"
    }
  },
  "tasks": {
    "dev": "deno run --watch --unstable class-decorators.ts",
    "run:class-decorators": "deno run --unstable class-decorators.ts",
    "run:method-decorators": "deno run --unstable method-decorators.ts",
    "run:decorators": "deno run --unstable decorators.ts",
    "run:all": "deno run --unstable class-decorators.ts method-decorators.ts decorators.ts",
    "check": "deno check --unstable *.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test --unstable"
  },
  "imports": {
    "std/": "https://deno.land/std@0.208.0/",
    "https://": "https://deno.land/x/",
    "reflect-metadata": "https://deno.land/x/reflect_metadata/mod.ts"
  }
}