{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "lib": ["deno.ns", "deno.window"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "options": {
      "useTabs": false,
      "indentWidth": 2,
      "lineWidth": 100,
      "singleQuote": false,
      "proseWrap": "preserve"
    }
  },
  "tasks": {
    "dev": "deno run --watch --allow-read --allow-net promises.ts",
    "run:promises": "deno run --allow-read promises.ts",
    "run:async-await": "deno run --allow-read async-await.ts",
    "run:async-iterators": "deno run --allow-read async-iterators.ts",
    "run:all": "deno run --allow-read promises.ts async-await.ts async-iterators.ts",
    "check": "deno check *.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test --allow-read"
  },
  "imports": {
    "std/": "https://deno.land/std@0.208.0/",
    "https://": "https://deno.land/x/"
  }
}